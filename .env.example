# Ứng dụng mặc định Microsoft 365 trong code. Trên web chỉ cần nhập email + mật khẩu;
# file này dùng khi chạy CLI hoặc chỉnh tay.

# SMTP (gửi) — có thể bỏ HOST/PORT nếu dùng mặc định trong code
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@company.com
SMTP_PASS=app-password-or-password

# IMAP (đọc phản hồi) — mặc định trong code; để trống user/pass = dùng chung SMTP
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=
IMAP_PASS=

# Thư mục file đính kèm khi gửi (mọi file trong thư mục sẽ kèm theo mỗi mail)
ATTACHMENTS_DIR=./data/attachments

# Trễ giữa mỗi mail (ms) — tránh bị giới hạn tốc độ
SEND_DELAY_MS=3500

# Thư mục lưu phản hồi
REPLIES_DIR=./data/replies

# --- Nhiều tài khoản + magic link + MongoDB (bật khi đặt MONGODB_URI) ---
# MONGODB_URI=mongodb://127.0.0.1:27017/mail-count
# (Railway Mongo plugin thường có MONGO_URL — app cũng đọc được biến đó.)
# JWT_SECRET=ít-nhất-16-ký-tự-ngẫu-nhiên
# Đăng nhập web: email + mật khẩu (bcrypt trong MongoDB). Seed 3 tài khoản mẫu:
#   npm run seed:users
# (hiendt@esuhai.com, ceo.offices@esuhai.com, hoangkha@esuhai.com — mật khẩu mặc định 123456789)
# URL gốc của giao diện web (magic link verify redirect về đây). Dev Vite: http://localhost:5173
# PUBLIC_APP_URL=http://localhost:5173
# SMTP_USER / SMTP_PASS ở trên: dùng làm mail *hệ thống* gửi magic link (không phải mailbox khảo sát của từng user).
#
# --- Magic link trên Railway / cloud (khuyến nghị) ---
# Resend bỏ qua SMTP tới Office365 (thường treo hoặc bị chặn từ IP datacenter). Nếu đặt RESEND_API_KEY thì
# app gửi magic link qua Resend; không cần SMTP cho bước đăng nhập (campaign vẫn dùng SMTP_USER nếu có).
# https://resend.com/docs/dashboard/emails/introduction
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Mail-count <noreply@your-verified-domain.com>

# SMTP (gửi) — Microsoft 365 thường dùng:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@company.com
SMTP_PASS=app-password-or-password

# IMAP (đọc phản hồi — cùng mailbox, tenant phải bật IMAP nếu dùng M365)
IMAP_HOST=outlook.office365.com
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=
IMAP_PASS=

# Để trống IMAP_USER/IMAP_PASS thì mặc định dùng SMTP_USER / SMTP_PASS

# Thư mục file đính kèm khi gửi (mọi file trong thư mục sẽ kèm theo mỗi mail)
ATTACHMENTS_DIR=./data/attachments

# Trễ giữa mỗi mail (ms) — tránh bị giới hạn tốc độ
SEND_DELAY_MS=3500

# Thư mục lưu phản hồi
REPLIES_DIR=./data/replies
